{
  "name": "fodmara",
  "private": true,
  "version": "1.0.0",
  "description": "Ilumie app template: React + TypeScript + Vite + Capacitor (iOS/Android), local-first, no backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "new-app": "node scripts/new-app.mjs",
    "postinstall": "node -e \"const fs=require('fs');fs.mkdirSync('public/assets',{recursive:true});fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','public/assets/sql-wasm.wasm')\"",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:store": "node scripts/store-frames.mjs",
    "smoke": "node smoke.mjs"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^7.0.0",
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.4.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^11.3.3",
    "health-bridge": "file:plugins/health-bridge",
    "i18next": "^24.2.0",
    "jeep-sqlite": "^2.8.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "sql.js": "1.12.0",
    "widget-bridge": "file:plugins/widget-bridge",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
